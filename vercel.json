{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/termo-founder",
      "destination": "/termos-founder",
      "permanent": false
    },
    {
      "source": "/servicos/reestruturacao-de-deck",
      "destination": "/servicos/criacao-de-pitch-deck",
      "permanent": true
    },
    {
      "source": "/servicos/financials-startups-agenticas",
      "destination": "/servicos/analise-financeira",
      "permanent": true
    },
    {
      "source": "/servicos/ma-advisor",
      "destination": "/servicos/assessoria-de-ma",
      "permanent": true
    },
    {
      "source": "/servicos/market-breakdown",
      "destination": "/servicos/raio-x-de-mercado",
      "permanent": true
    },
    {
      "source": "/ai-agents/ai-first-financials",
      "destination": "/servicos/analise-financeira",
      "permanent": false
    },
    {
      "source": "/ai-agents/pitchdeck",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ai-agents",
      "destination": "/servicos",
      "permanent": true
    },
    {
      "source": "/ai-agents/",
      "destination": "/servicos",
      "permanent": true
    },
    {
      "source": "/ai-agents/:path*",
      "destination": "/servicos/:path*",
      "permanent": true
    },
    {
      "source": "/ranking",
      "destination": "/vitrine",
      "permanent": true
    },
    {
      "source": "/ranking/",
      "destination": "/vitrine",
      "permanent": true
    },
    {
      "source": "/ranking/:path*",
      "destination": "/vitrine/:path*",
      "permanent": true
    },
    {
      "source": "/hubs",
      "destination": "/b2b",
      "statusCode": 301
    },
    {
      "source": "/hubs/",
      "destination": "/b2b",
      "statusCode": 301
    },
    {
      "source": "/hubs/:path*",
      "destination": "/b2b",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/w/:ref",
      "destination": "/api/w?ref=:ref"
    },
    {
      "source": "/w",
      "destination": "/api/w"
    },
    {
      "source": "/nota",
      "destination": "https://pitchdeck-v2-free-production.up.railway.app/nota"
    },
    {
      "source": "/nota/api/:path*",
      "destination": "https://pitchdeck-v2-free-production.up.railway.app/api/:path*"
    },
    {
      "source": "/calculadora-de-valuation",
      "destination": "https://pitchdeck-v2-free-production.up.railway.app/calculadora-de-valuation"
    },
    {
      "source": "/calculadora-de-valuation/api/:path*",
      "destination": "https://pitchdeck-v2-free-production.up.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/vitrine",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/para-quem-investe",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/b2b",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
